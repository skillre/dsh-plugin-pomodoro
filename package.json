{
  "name": "@skillre/dsh-plugin-pomodoro",
  "version": "0.1.0",
  "description": "Pomodoro focus clock for the DSH Web UI: a persistent work/break timer with daily round counts and local preferences",
  "icon": "./icon.svg",
  "type": "module",
  "license": "MIT",
  "author": "skillre",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.1.7-rc.2 <0.2.0"
  },
  "packageManager": "npm@11.12.1",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./compatibility.json": "./compatibility.json",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "compatibility.json",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "UNINSTALL.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skillre/dsh-plugin-pomodoro.git"
  },
  "bugs": {
    "url": "https://github.com/skillre/dsh-plugin-pomodoro/issues"
  },
  "homepage": "https://github.com/skillre/dsh-plugin-pomodoro#readme",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "cordis",
    "pomodoro",
    "focus",
    "timer",
    "番茄时钟"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc -p tsconfig.build.json && npm run build:client",
    "build:client": "node scripts/build-client.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "npm run build:client && vitest run",
    "pack:check": "npm run build && publint && npm pack --dry-run --json --ignore-scripts",
    "check": "npm run typecheck && npm test && npm run pack:check",
    "changeset": "changeset",
    "version": "changeset version",
    "release:prepare": "node scripts/prepare-release.mjs",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.3"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.2",
    "@deepseek-ai/cordis": "^4.0.3",
    "@types/node": "^24.13.3",
    "@types/react": "~18.3.1",
    "esbuild": "^0.25.0",
    "publint": "^0.3.24",
    "react": "^18.2.0",
    "typescript": "7.0.2",
    "vitest": "^4.1.8"
  }
}
